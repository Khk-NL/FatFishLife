{
  "schema_version": 1,
  "title": "大肥鱼模板样片 · news",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "background": "#5AA6CF"
  },
  "template": "news",
  "assets": {
    "silver": "../assets/originals/role-silver.jpg",
    "blue": "../assets/originals/role-blue.jpg",
    "red": "../assets/originals/role-red.jpg",
    "red_expression": "../assets/originals/role-red-expression.jpg",
    "notice": {
      "path": "../assets/originals/reference-layout.png",
      "crop": [
        300,
        0,
        970,
        440
      ]
    }
  },
  "music": {
    "path": "../assets/music/demo-original.wav",
