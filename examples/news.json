    {
      "duration": 10,
      "roles": [
        "red"
      ],
      "panel": "notice",
      "captions": [
        {
          "start": 0.0,
          "end": 5.0,
          "text": "图归图，角色归角色。"
        },
        {
          "start": 5.0,
          "end": 10.0,
          "text": "分层摆放，换一期也不费劲。"
        }
      ]
    },
    {
      "duration": 10,
      "roles": [
        "silver"
      ],
      "panel": "notice",
      "caption": "换上你的新话题，下一条就能继续开工。",
