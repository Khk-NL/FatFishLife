  "files": ["index.mjs", "settings.mjs", "client.js", "cordis.patch.yml", "locale"],
  "engines": { "dsh": ">=0.2.1-rc.3 <0.3.0-0" },
  "peerDependencies": { "@deepseek-ai/cordis": "~4.0.5", "@deepseek-ai/schemastery": "~3.18.5", "@deepseek-ai/dsh-tools": "0.2.1-rc.3" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": {
    "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-plugin-manager"], "platform": "web"
  } }
}
